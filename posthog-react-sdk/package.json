{
  "name": "posthog-react-sdk",
  "version": "1.0.0",
  "description": "Standalone React SDK for PostHog UI components",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "build:lib": "vite build -c vite.config.ts",
    "build": "npm run build:types && npm run build:lib",
    "preview": "vite preview"
  },
  "dependencies": {
    "chartjs-adapter-dayjs-3": "^1.0.0",
    "chartjs-plugin-annotation": "^3.0.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-stacked100": "^1.0.1",
    "chartjs-plugin-trendline": "^2.0.3",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "chart.js": "^4.4.2",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "chart.js": "^4.4.2",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
